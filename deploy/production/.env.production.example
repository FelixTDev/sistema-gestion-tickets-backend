# Copy to .env.production, replace placeholders, then chmod 600.
# Generate independent values for these three secrets with: openssl rand -hex 32
MYSQL_DATABASE=tickets
MYSQL_USER=tickets_app
MYSQL_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
SECRET_KEY=REPLACE_WITH_A_THIRD_64_HEX_VALUE

# Brevo SMTP credentials. Use the SMTP key, never the Brevo API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
SMTP_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER@example.com
SMTP_TIMEOUT_SECONDS=10

# Public frontend used for password reset and email verification links.
FRONTEND_BASE_URL=https://portal.felixtintaya.com

# Keep AI off until the separately authorized live-provider smoke test.
CHATBOT_AI_ENABLED=false
CHATBOT_AI_PROVIDER=noop
CHATBOT_AI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
