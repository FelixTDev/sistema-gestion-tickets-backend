APP_NAME=Ticket Management API
APP_ENV=development
DEBUG=true
MYSQL_PORT=3307
DATABASE_URL=mysql+pymysql://tickets:tickets@localhost:3307/tickets
DATABASE_CONNECT_TIMEOUT_SECONDS=3
MYSQL_DATABASE=tickets
MYSQL_USER=tickets
MYSQL_PASSWORD=tickets
MYSQL_ROOT_PASSWORD=change-this-local-password
SECRET_KEY=change-this-development-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
EMAIL_PROVIDER=noop
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_BLOCK_SECONDS=900
ATTACHMENT_STORAGE_DIR=var/uploads
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
ATTACHMENT_MAX_TOTAL_SIZE_PER_TICKET_BYTES=52428800
ATTACHMENT_MAX_FILES_PER_TICKET=10
ATTACHMENT_ALLOWED_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".gif",".txt"]
ATTACHMENT_ALLOWED_MIME_TYPES=["application/pdf","image/png","image/jpeg","image/gif","text/plain"]
SLA_DEFAULT_TIMEZONE=UTC
SLA_DEFAULT_CALENDAR=24x7
SLA_POLICY_DEFAULTS={"BAJA":{"first_response_seconds":86400,"resolution_seconds":259200,"warning_seconds":21600},"MEDIA":{"first_response_seconds":43200,"resolution_seconds":172800,"warning_seconds":10800},"ALTA":{"first_response_seconds":14400,"resolution_seconds":86400,"warning_seconds":7200},"URGENTE":{"first_response_seconds":3600,"resolution_seconds":28800,"warning_seconds":1800}}
REPORT_EXPORT_MAX_ROWS=10000
REPORT_EXPORT_MAX_RANGE_DAYS=366
CHATBOT_HIGH_CONFIDENCE_THRESHOLD=0.70
CHATBOT_MEDIUM_CONFIDENCE_THRESHOLD=0.35
CHATBOT_MAX_TURNS=50
CHATBOT_MESSAGES_PER_MINUTE=20
CHATBOT_MAX_MESSAGE_LENGTH=2000
# Also bounds the minimized user/history text sent to an enabled AI provider.
CHATBOT_MAX_ANONYMOUS_CONVERSATIONS_PER_HOUR=10
CHATBOT_MAX_CLARIFICATION_ATTEMPTS=2
CHATBOT_MAX_CONVERSIONS_PER_DAY=5
CHATBOT_AI_ENABLED=false
CHATBOT_AI_PROVIDER=noop
# Configure only an approved internal gateway; never commit its key.
CHATBOT_AI_ENDPOINT=
CHATBOT_AI_API_KEY=
CHATBOT_AI_MODEL=gpt-5.4-mini
# Embeddings use the same OpenAI key and are cached in process memory.
CHATBOT_AI_EMBEDDINGS_ENABLED=true
CHATBOT_AI_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_AI_EMBEDDING_DIMENSIONS=256
CHATBOT_AI_EMBEDDING_MAX_DOCUMENTS=200
# Keep this secret in the local .env file; never commit or expose it to the frontend.
OPENAI_API_KEY=
CHATBOT_AI_PROMPT_VERSION=v1
CHATBOT_AI_TIMEOUT_SECONDS=15
CHATBOT_AI_MAX_OUTPUT_CHARS=1200
CHATBOT_AI_MAX_OUTPUT_TOKENS=384
CHATBOT_AI_MAX_DOCUMENTS=3
CHATBOT_AI_MAX_CONTEXT_CHARS=6000
CHATBOT_AI_MIN_CONFIDENCE=0.70
CHATBOT_AI_REQUESTS_PER_MINUTE=5
CHATBOT_AI_MAX_RESPONSES_PER_CONVERSATION=3
CHATBOT_AI_MAX_PROVIDER_CALLS_PER_ACTOR_PER_HOUR=20
CHATBOT_AI_DAILY_BUDGET_USD=0.50
CHATBOT_AI_MAX_CONSECUTIVE_FAILURES=3
CHATBOT_AI_COOLDOWN_SECONDS=60
CHATBOT_AI_IDEMPOTENCY_WINDOW_SECONDS=30
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEMO_CLIENT_PASSWORD=demo-password-local
DEMO_ADVISOR_PASSWORD=demo-password-local
DEMO_SUPERVISOR_PASSWORD=demo-password-local
