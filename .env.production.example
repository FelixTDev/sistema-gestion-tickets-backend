# Copy this file to .env.production on the VPS, then replace every CHANGE_ME.
# Use hex-only values for database passwords so DATABASE_URL needs no escaping.
APP_NAME=Banco GNB Atención Digital API
MYSQL_DATABASE=tickets
MYSQL_USER=tickets_app
MYSQL_PASSWORD=CHANGE_ME_64_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=CHANGE_ME_64_HEX_CHARACTERS
SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS

# Brevo transactional SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_BREVO_SMTP_LOGIN
SMTP_PASSWORD=CHANGE_ME_BREVO_SMTP_KEY
SMTP_FROM_EMAIL=CHANGE_ME_VERIFIED_SENDER_EMAIL

# Keep AI disabled until OPENAI_API_KEY is configured and a live test is planned.
CHATBOT_AI_ENABLED=false
CHATBOT_AI_PROVIDER=noop
CHATBOT_AI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
